{
  "name": "osm-wiki-preview",
  "displayName": "OSM Wiki Preview",
  "description": "Preview MediaWiki wikitext files using the OpenStreetMap wiki API",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:wikitext",
    "workspaceContains:**/*.wiki"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "osm-wiki-preview.preview",
        "title": "Preview Wiki",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "osm-wiki-preview.preview",
          "when": "resourceExtname == .wiki",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "osm-wiki-preview.preview",
          "when": "resourceExtname == .wiki",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.0.0"
  }
}
